{% extends 'partials/base.html.twig' %}

{% block content %}
<section class="py-8 lg:py-12 ">
<section class="px-4 py-16 max-w-screen-xl mx-auto">
  <div class="grid grid-cols-1 md:grid-cols-2 gap-8 items-start">
      <div>
        <img src="{{ theme_url }}/images/photos/wisniewscy.jpg" alt="Złocony grawer artystyczny na płycie pomnika w Dąbrowie Górniczej" class="w-full object-cover golden-img-border hard-shadow">
    </div>
            <div class="flex flex-col space-y-6">
        {# <h2 class="text-3xl font-bold text-gray-800 mb-4 border-bot-cherry">
            Eksperci w kamieniarstwie - Wiśniewscy chętnie służą pomocą!
        </h2> #}
        <h2 class="text-3xl md:text-4xl font-bold text-gray-800 border-bot-cherry">
            <span class="c-cherry block font-semibold text-2xl">Eksperci w kamieniarstwie:</span>
                Wiśniewscy chętnie służą pomocą!
        </h2>
        <p class="text-lg text-gray-700">
           Poznaj sprawdzone wskazówki dotyczące wyboru granitu, pielęgnacji nagrobków i nowoczesnych rozwiązań kamieniarskich. 
           Kamieniarstwo Wiśniewski to firma zbudowana na wartościach, dlatego staramy się, aby klient doskonale rozumiał proces kamieniarski i był pewien inwestycji w nagrobek.

        </p>
        <p class="text-lg text-gray-700">
           W naszych artykułach znajdziesz odpowiedzi na najczęstsze pytania, porównania materiałów oraz wskazówki, które ułatwią wybór odpowiedniego granitu czy projektu nagrobka.
        </p>
    </div>
</section>
    {# SEKCJA WPROWADZAJĄCA #}
    <section class="w-full my-8 py-8 px-4">
        <div class="mx-auto max-w-5xl grid grid-cols-1 md:grid-cols-[2fr_1fr] gap-8 md:gap-16 items-center white-gradient-down">

            <div class="py-6 md:py-10">
                <blockquote class="founder__quote text-gray-700">
                    <h4 class="mb-8 border-bot-pink pb-4 leading-[1.9]">
                        "Dekady doświadczenia w branży kamieniarskiej przekazałem mojemu synowi, Marcinowi Wiśniewskiemu. Razem dzielimy się wiedzą z klientami, aby współpraca z Państwem była jak najbardziej satysfakcjonująca."
                    </h4>
                    <p class="text-md md:text-base font-medium c-cherry not-italic text-right">
                        — Mieczysław Wiśniewski, <br>założyciel firmy Kamieniarstwo Wiśniewski z Dąbrowy Górniczej.
                    </p>
                </blockquote>
            </div>

            <img 
                src="{{ theme_url }}/images/photos/sharing-knowledge.jpg" 
                alt="Mieczysław Wiśniewski - założyciel firmy"
                class="golden-img-border w-56 h-56 md:w-72 md:h-72 mx-auto md:mx-0 object-cover shadow-lg"
            >

        </div>
    </section>

    {# NAGŁÓWEK SEKCJI ARTYKUŁÓW #}
    <div class="flex section-header mx-auto my-8">
        <div class="section-header__content section-header__bg--black">
            <h3 class="text-xl md:text-2xl text-center font-semibold fill-letters-gold-section uppercase">
                {{ page.header.top_label|default('Artykuły') }}
            </h3>
        </div>
    </div>

    {# SIATKA KART ARTYKUŁÓW #}
    <div class="max-w-screen-xl mx-auto px-4">
    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-12">

        {% set collection = page.collection() %}

        {% if collection|length > 0 %}
            {% for child in collection %}
                {# Dodano flex flex-col i h-full dla poprawnego działania flex-grow #}
                <a href="{{ child.url }}" class="flex flex-col article-card group">
                    
                    <div class="article-card__image overflow-hidden">
                        {% set card_image_name = child.header.main_image %}
                        {% set image = card_image_name ? child.media[card_image_name] : child.media.images|first %}
                        
                        {% if image %}
                            {{ image.cropZoom(800, 600).html(child.title, child.title, 'w-full object-cover')|raw }}
                        {% endif %}
                    </div>
                    
                    {# Dodano flex flex-col flex-grow dla spójnego wyglądu #}
                    <div class="article-card__content flex flex-col flex-grow p-6">
                        <h3 class="article-card__title underline--light-grey">{{ child.title }}</h3>
                        
                        {# Opis rozpycha kartę #}
                        <p class="article-card__description flex-grow">
                            {{ child.header.meta_description|default(child.summary(150)) }}
                        </p>
                        
                        {# Przycisk i meta zawsze na dole #}
                        <div class="mt-4">
                            <span class="btn-tertiary w-full mx-auto text-center">Czytaj więcej</span>
                            
                            <div class="article-card__meta mt-4">
                                <div class="article-card__meta-item">
                                    <img src="{{ url('theme://images/svg/articleCard--calendar.svg') }}" alt="" class="icon-svg">
                                    <span>{{ child.date|date("d.m.Y") }}</span>
                                </div>
                                
                                {% if child.taxonomy.category %}
                                <div class="article-card__meta-item">
                                    <span>{{ child.taxonomy.category|first }}</span>
                                </div>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                </a>
            {% endfor %}
        {% else %}
            <p class="text-center text-gray-500 md:col-span-2 lg:col-span-3">Brak artykułów do wyświetlenia.</p>
        {% endif %}
        
    </div>
</div>

    {# PAGINACJA #}
    {% if config.plugins.pagination.enabled and collection.params.pagination %}
        <div class="mt-8 flex justify-center">
            {% include 'partials/pagination.html.twig' with {'base_url': page.url, 'pagination': collection.params.pagination} %}
        </div>
    {% endif %}

</section>
{% endblock %}
