<section class="py-8 lg:py-12">
    {# --- NAGŁÓWEK SEKCJI --- #}
    <div class="flex section-header mx-auto my-8">
        <div class="section-header__content section-header__bg--black">
            <h3 class="text-xl md:text-2xl text-center font-semibold fill-letters-gold-section uppercase">
                {{ page.header.top_label|default('Polecane Artykuły') }}
            </h3>
        </div>
    </div>

    {# --- SIATKA KART --- #}
    <div class="max-w-screen-xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8 my-12">

            {% set collection = page.find('/artykuly').children %}

            {% if collection|length > 0 %}
                {% set random_articles = collection.shuffle().slice(0, 3) %}
                
                {% for child in random_articles %}
                    {# ZMIANA: Dodano 'flex flex-col' aby karta mogła użyć flex-grow #}
                    <a href="{{ child.url }}" class="flex flex-col article-card group">
                      
                      <div class="article-card__image">
                        {% set card_image_name = child.header.main_image %}
                        {% set image = card_image_name ? child.media[card_image_name] : child.media.images|first %}
                        {% if image %}
                            {{ image.cropZoom(800, 600).html(child.title, child.title, 'w-full object-cover')|raw }}
                        {% endif %}
                      </div>
                      
                      {# ZMIANA: Dodano 'flex flex-col flex-grow' aby treść rozpychała kartę #}
                      <div class="article-card__content flex flex-col flex-grow">
                        <h3 class="article-card__title underline--light-grey">{{ child.title }}</h3>
                        
                        {# ZMIANA: flex-grow-1 sprawia, że opis zajmuje całe wolne miejsce #}
                        <p class="article-card__description flex-grow">
                          {{ child.header.meta_description|default(child.summary(150)) }}
                        </p>
                        
                        {# Elementy poniżej zawsze będą na dole dzięki flex-grow powyżej #}
                        <div class="mt-4">
                            <span class="btn-tertiary w-full mx-auto text-center">Czytaj więcej</span>
                            
                            <div class="article-card__meta mt-4">
                              <div class="article-card__meta-item">
                                <img src="{{ url('theme://images/svg/articleCard--calendar.svg') }}" alt="" class="icon-svg">
                                <span>{{ child.date|date("d.m.Y") }}</span>
                              </div>
                              
                              {% if child.taxonomy.category %}
                              <div class="article-card__meta-item">
                                <span>{{ child.taxonomy.category|first }}</span>
                              </div>
                              {% endif %}
                            </div>
                        </div>
                      </div>
                    </a>
                {% endfor %}
            {% else %}
                <p class="text-center text-gray-500 md:col-span-2 lg:col-span-3">Brak artykułów w folderze /artykuly.</p>
            {% endif %}
        </div>
    </div>
</section>